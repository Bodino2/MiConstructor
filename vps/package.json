{
  "name": "miconstructor-vps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && rm -rf lib && cp -R ../lib ./lib",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/src/migrate.js",
    "seed:admin": "tsx src/seed-admin.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "stripe": "^18.4.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.17.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
