[Unit]
Description=MiConstructor production API and web app
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=miconstructor
Group=miconstructor
WorkingDirectory=/var/www/miconstructor/current/vps
EnvironmentFile=/etc/miconstructor/api.env
ExecStartPre=/usr/bin/node dist/src/migrate.js
ExecStart=/usr/bin/node dist/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/miconstructor /var/log/miconstructor
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
# Node/V8 necesita transiciones de memoria a ejecutable para el JIT; activarlo provoca SIGTRAP al iniciar.
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
